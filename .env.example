# Copy to .env and fill in. Never commit .env.

# --- Email (verification links). If unset, links are printed to the console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Model server (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Context window (prompt + reply) and max reply length, in tokens.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
# Thinking models only (e.g. qwen3). Leave UNSET unless you have tested it:
# with qwen3:4b, OLLAMA_THINK=false makes the model write its reasoning into
# the visible reply. Unset/true keeps reasoning in a hidden field.
# Thinking tokens count toward OLLAMA_NUM_PREDICT and take time.
# OLLAMA_THINK=true
# OLLAMA_TEMPERATURE=0.7
# Timeouts in milliseconds.
OLLAMA_FIRST_BYTE_TIMEOUT_MS=120000
OLLAMA_IDLE_TIMEOUT_MS=60000
OLLAMA_TOTAL_TIMEOUT_MS=300000

# --- Data
# Delete conversations this many days after their last message. 0 = keep until the user deletes them.
RETENTION_DAYS=0
# DB_PATH=emailai.sqlite
# UPLOAD_DIR=./uploads

# --- Public address
# Base URL used in emailed links (verification, password reset). REQUIRED in production,
# otherwise links are built from the request's Host header, which can be forged.
# APP_URL=https://arisa.example.com

# --- Networking
# Set to true only behind a reverse proxy you control (trusts X-Forwarded-For for rate limiting).
TRUST_PROXY=false
